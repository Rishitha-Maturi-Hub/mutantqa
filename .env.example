# Copy to .env and fill in. Never commit .env.
# LiteLLM reads the standard provider variables; set only the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Demo app model (any LiteLLM model string). Leave unset for the offline simulator.
DEMO_MODEL=gpt-4o-mini
# Model used by mutant m4 ("switch to a weaker model").
DEMO_WEAK_MODEL=gpt-3.5-turbo
